<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Permit cleartext HTTP for remote subscription endpoints and local proxy loopback.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
